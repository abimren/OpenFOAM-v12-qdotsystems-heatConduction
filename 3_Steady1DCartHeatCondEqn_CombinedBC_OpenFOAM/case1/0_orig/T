FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 20;

boundaryField
{
    leftWall
    {
        type            codedMixed;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;

        name    convectionLeftWall;

        code
        #{
            const scalarField& delta = patch().deltaCoeffs();
            const scalar h=10.0;
            const scalar Tinf=100.0;
            const scalar k=10.0;
            const scalar q=150.0;
            this->refValue() = Tinf;
            this->refGrad() = q/k;
            this->valueFraction() = 1.0/(1.0+k/(h*(1.0/delta)));
        #};
    }

    rightWall
    {
        type            codedMixed;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;

        name    convectionRightWall;

        code
        #{
            const scalarField& delta = patch().deltaCoeffs();
            const scalar h=10.0;
            const scalar Tinf=10.0;
            const scalar k=10.0;
            const scalar q=0.0;
            this->refValue() = Tinf;
            this->refGrad() = q/k;
            this->valueFraction() = 1.0/(1.0+k/(h*(1.0/delta)));
        #};
    }

    otherWalls
    {
        type            	empty;
    }
}

