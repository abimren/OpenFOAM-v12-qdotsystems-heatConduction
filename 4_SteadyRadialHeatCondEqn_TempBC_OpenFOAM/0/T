FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 20;

boundaryField
{
	innerWall
	{
		type		fixedValue;
		value		uniform 100;
	}
	
	outerWall
	{
		type		fixedValue;
		value		uniform 20;
	}
	
	symmetryWalls
	{
		type		fixedGradient;
		gradient	uniform 0;
	}
	
	emptyWalls
    {
        type       	empty;
    }
}

