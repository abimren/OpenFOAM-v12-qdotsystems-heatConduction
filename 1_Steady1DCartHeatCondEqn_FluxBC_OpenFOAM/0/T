FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 20;

boundaryField
{
    leftWall
    {
        type            fixedGradient;
        gradient        uniform 10;
    }
    
    rightWall
    {
        type            fixedValue;
        value           uniform 20;
    }
    
    otherWalls
    {
        type            empty;
    }
}

