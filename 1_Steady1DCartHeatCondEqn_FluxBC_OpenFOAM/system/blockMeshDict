FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters   1;

//variables
L 10;

vertices
(
	//Left Face
	(0 0 0)		//0
	(0 1 0)		//1
	(0 1 1)		//2
	(0 0 1)		//3
	//Right Face
	($L 0 0)	//4
	($L 1 0)	//5
	($L 1 1)	//6
	($L 0 1)	//7
);

blocks
(
	//This aligns the tube in the local x1 axis
	hex (0 4 5 1 3 7 6 2) (100 1 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
	leftWall
	{
		type wall;
		faces
		(
			(0 3 2 1)
		);
	}
	
	rightWall
	{
		type wall;
		faces
		(
			(4 5 6 7)
		);
	}
	
	otherWalls
	{
        	type empty;
        	faces
        	(
            		(0 1 5 4)
            		(0 4 7 3)
            		(1 2 6 5)
            		(3 7 6 2)
        	);
	}
);

mergePatchPairs
(
);

